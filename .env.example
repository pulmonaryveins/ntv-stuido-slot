# Server-only (BFF). None of these reach the browser bundle. Set the same three in Vercel
# Project Settings -> Environment Variables. Leave SUPABASE_* empty to run the mock demo.
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_ANON_KEY=your-anon-key
# 32+ random characters; encrypts the session cookie. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# Supabase secrets (not app env): npx supabase secrets set DISCORD_WEBHOOK_URL=...
